                                            onDoubleTap = {
                                                /* Handle button click → WRITE Brew Configuration */
                                                keyboardController?.hide()      // Hide the keyboard when the button is clicked
                                                if(!(cPterm_TB.userInput.text.isNullOrBlank() && cIterm_TB.userInput.text.isNullOrBlank()
