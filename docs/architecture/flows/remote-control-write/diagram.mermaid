flowchart LR
    subgraph user["👤 User"]
        direction LR
        U_EDIT["Edit CTextBox field\nonValueChange: digits only\nmodified = true"]
        U_DONE["Keyboard Done action\nonDone: clamp to min/max"]
        U_WRITE["Double-tap WRITE button"]
    end

    subgraph screen["🖥️ RemoteControlScreen"]
        direction LR
        S_DETECT["detectTapGestures\nonDoubleTap handler"]
        S_CHECK["Pass value if modified and not blank\nelse pass null\nfor 8 machine config fields"]
        S_RESET["reset modified = false\nfor each written CTextBox"]
        S_TOAST["Toast: Sending modified configuration\nor No fields modified"]
    end

    subgraph vm["📊 ViewModel — RemoteControlViewModel"]
        direction LR
        VM_WRITE["writeMachineConfig(\nboilerTemp / steamTemp\npreInfPwr / preInfTmr\ninfPwr / infTmr\ndeclPwr / declTmr)"]
        VM_SKIP["Skip null fields\nnot modified"]
        VM_TX["txNewBoilerTargetTemp\ntxNewSteamTempSetpoint\ntxWritePreInfusionPwr\ntxWritePreInfusionTmr\ntxWriteInfusionPwr\ntxWriteInfusionTmr\ntxWriteDecliningPwr\ntxWriteDecliningTmr"]
    end

    subgraph mgr["📡 BLE Manager — RemoteControlBLEReceiveManager"]
        direction LR
        M_ENC["writeCharacteristic\ndataConvertionFloatToCharacteristic\nFloat to ASCII fixed-width string"]
        M_FIND["findCharacteristic\nserviceUUID + charUUID"]
        M_WRITE["writeCharacteristicsDevice\ngatt.writeCharacteristic\nWRITE_TYPE_NO_RESPONSE"]
        M_CB["onCharacteristicWrite\nGATT_SUCCESS logged per UUID"]
    end

    subgraph gatt["🔵 BLE Device — GATT"]
        direction LR
        G_CHARS["0x1403 Boiler Setpoint\n0x140A Steam Setpoint\n0x1404-0x1409 Brew Params\nCharacteristic values updated"]
    end

    U_EDIT --> U_DONE --> U_WRITE
    U_WRITE --> S_DETECT --> S_CHECK --> VM_WRITE
    VM_WRITE --> VM_SKIP --> VM_TX
    VM_TX --> M_ENC --> M_FIND --> M_WRITE
    M_WRITE --"gatt.writeCharacteristic"--> G_CHARS
    G_CHARS --"onCharacteristicWrite GATT_SUCCESS"--> M_CB
    VM_WRITE --"returns anyModified Boolean"--> S_RESET --> S_TOAST
